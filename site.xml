<!-- ============================================================
     SITE.XML  -  edit this single file to change the whole site.
     Colors accept any CSS color (#hex, rgb(), names).
     linkColor = inactive menu/links, linkHoverColor = hover/active.
     ============================================================ -->
<site>
  <settings>
    <title>Rick Alday</title>
    <description>Visual Artist</description>
    <backgroundColor>#f4f3ef</backgroundColor>
    <textColor>#0d0d0b</textColor>
    <linkColor>#6b6b67</linkColor>
    <linkHoverColor>#0d0d0b</linkHoverColor>
    <accentColor>#ff7002</accentColor>
    <hoverSlideSpeed>600</hoverSlideSpeed><!-- ms between preview images on hover -->
    <fontFamily>"Abel", sans-serif</fontFamily>
    <displayFontFamily>"Oranienbaum", serif</displayFontFamily>
    <defaultPage>index</defaultPage>
  </settings>

  <header>
    <logo>Rick Alday</logo>
    <!-- Footer social links: add, remove or reorder <link> entries. -->
    <social>
